{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/codemap-rules-version.sh\"",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/manager-run-compact.sh\" SessionStart",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/manager-run-compact.sh\" PreCompact",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/prefer-plugin-agents.sh\"",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/codemap-commit-check.sh\"",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/codemap-search-nudge.sh\"",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
