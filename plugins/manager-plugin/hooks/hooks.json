{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/prefer-plugin-agents.sh\"",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/codemap-commit-check.sh\"",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
